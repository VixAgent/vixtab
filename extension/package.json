{
  "name": "vixtab",
  "publisher": "phanthaitrung",
  "displayName": "VixTab — parallel Claude Code tabs",
  "description": "Orchestrate many Claude Code sessions on one repo: one fresh, labeled tab per ticket in its own column, conflict-free merges, context-saving orchestration.",
  "version": "0.5.0",
  "license": "MIT",
  "icon": "icon.png",
  "author": "phanthaitrung",
  "homepage": "https://github.com/VixAgent/vixtab",
  "repository": { "type": "git", "url": "https://github.com/VixAgent/vixtab.git" },
  "bugs": { "url": "https://github.com/VixAgent/vixtab/issues" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["AI", "Other"],
  "keywords": ["claude", "claude code", "orchestration", "multi-agent", "parallel", "git worktree", "tabs", "agents"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "extensionKind": ["workspace"],
  "extensionDependencies": ["anthropic.claude-code"],
  "contributes": {
    "commands": [
      { "command": "vixtab.orchestrate", "title": "Start orchestrator", "category": "VixTab", "icon": "$(rocket)" },
      { "command": "vixtab.setup", "title": "Set up (vixtab command + Claude Code skills)", "category": "VixTab" },
      { "command": "vixtab.doctor", "title": "Run doctor", "category": "VixTab" },
      { "command": "vixtab.status", "title": "Show status (is this project set up? versions)", "category": "VixTab" },
      { "command": "vixtab.createPlayground", "title": "Create playground", "category": "VixTab" },
      { "command": "vixtab.evenColumns", "title": "Even column widths", "category": "VixTab" },
      { "command": "vixtab.refresh", "title": "Refresh", "category": "VixTab", "icon": "$(refresh)" },
      { "command": "vixtab.enableHere", "title": "Set up VixTab for this project", "category": "VixTab" },
      { "command": "vixtab.showTicket", "title": "Show ticket", "category": "VixTab" },
      { "command": "vixtab.openSettings", "title": "Settings", "category": "VixTab", "icon": "$(gear)" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "vixtab", "title": "VixTab", "icon": "media/vixtab-activity.svg" }]
    },
    "views": {
      "vixtab": [{ "id": "vixtab.panel", "name": "VixTab", "icon": "media/vixtab-activity.svg", "contextualTitle": "VixTab" }]
    },
    "menus": {
      "view/title": [
        { "command": "vixtab.orchestrate", "when": "view == vixtab.panel", "group": "navigation@1" },
        { "command": "vixtab.refresh", "when": "view == vixtab.panel", "group": "navigation@2" },
        { "command": "vixtab.openSettings", "when": "view == vixtab.panel", "group": "navigation@3" }
      ],
      "commandPalette": [
        { "command": "vixtab.showTicket", "when": "false" },
        { "command": "vixtab.refresh", "when": "false" }
      ]
    },
    "configuration": {
      "title": "VixTab",
      "properties": {
        "vixtab.statusBar": { "type": "boolean", "default": true, "description": "Show the 'VixTab' button in the status bar." },
        "vixtab.orchestratorPrompt": { "type": "string", "default": "/vixtab-orchestrate ", "description": "Text pre-filled in the orchestrator tab (not sent)." },
        "vixtab.skillsScope": {
          "type": "string",
          "enum": ["allProjects", "perProject"],
          "enumDescriptions": [
            "Every project: the skills live in ~/.claude/skills, so every Claude Code session on this machine can use VixTab.",
            "Only the repositories you orchestrate: the VixTab button adds the skills to <repo>/.claude/skills (kept out of git); sessions of other projects never see them."
          ],
          "default": "allProjects",
          "description": "Where VixTab's Claude Code skills apply. Changing it applies at once."
        },
        "vixtab.closeEmptyTicketWindows": { "type": "boolean", "default": true, "description": "Close a ticket window (opened by VixTab) when its last Claude tab closes." }
      }
    }
  }
}
